        {"lastName": "{{Contact.Attribute.\"Last Name\"}}"},
        {"loyaltyTier": "{{Contact.Attribute.\"Loyalty Tier\"}}"},
        {"languagePreference": "{{Contact.Attribute.\"Language Preference\"}}"},
        {"leadId": "{{Lead_Events.LeadId}}"},
        {"leadSource": "{{Lead_Events.LeadSource}}"},
        {"company": "{{Lead_Events.Company}}"},
